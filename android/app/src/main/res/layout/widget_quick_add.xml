<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:padding="8dp">

    <ImageButton
        android:id="@+id/widget_btn_expense"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:contentDescription="@string/widget_add_expense"
        android:background="@drawable/widget_btn_bg"
        android:layout_marginEnd="4dp"
        android:src="@drawable/ic_shortcut_expense"
        android:scaleType="center" />

    <ImageButton
        android:id="@+id/widget_btn_income"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:contentDescription="@string/widget_add_income"
        android:background="@drawable/widget_btn_bg"
        android:layout_marginStart="4dp"
        android:src="@drawable/ic_shortcut_income"
        android:scaleType="center" />
</LinearLayout>
