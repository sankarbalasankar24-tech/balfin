<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Smooth mint circle with NO white rim -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#42E5A2"
                android:endColor="#00A86B"
                android:type="linear" />
        </shape>
    </item>
    <!-- Solid Black Horizontal Bar -->
    <item
        android:top="29dp"
        android:bottom="29dp"
        android:left="20dp"
        android:right="20dp">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="#000000" />
        </shape>
    </item>
    <!-- Solid Black Vertical Bar -->
    <item
        android:top="20dp"
        android:bottom="20dp"
        android:left="29dp"
        android:right="29dp">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="#000000" />
        </shape>
    </item>
</layer-list>
